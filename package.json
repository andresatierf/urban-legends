{
  "name": "urban-legends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check 'src/**/*.{ts,tsx,js,jsx}' 'convex/**/*.{ts,tsx,js,jsx}'",
    "format:fix": "oxfmt --write 'src/**/*.{ts,tsx,js,jsx}' 'convex/**/*.{ts,tsx,js,jsx}'",
    "ci": "bun --bun run lint && bun --bun run format",
    "routes:generate": "node scripts/generate-routes.mjs",
    "pretypecheck": "bun --bun run routes:generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sandcastle": "bun --bun .sandcastle/main.ts",
    "fallow": "npx fallow",
    "fallow:ci": "npx fallow --ci"
  },
  "dependencies": {

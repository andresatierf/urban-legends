# Convex Backend Configuration
# Get these values from https://dashboard.convex.dev
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk Authentication Configuration
# Get these values from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SECRET=

# Clerk URL Configuration
# These control the authentication flow redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Storage Provider Configuration
# Options: "s3" (AWS S3) | "r2" (Cloudflare R2)
STORAGE_PROVIDER=s3

# AWS S3 Configuration (for STORAGE_PROVIDER=s3)
# Get these from AWS IAM console: https://console.aws.amazon.com/iam/
AWS_REGION=us-east-1
AWS_S3_BUCKET=urban-legends-submissions
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: custom S3-compatible endpoint
AWS_S3_ENDPOINT=

# Cloudflare R2 Configuration (for STORAGE_PROVIDER=r2)
# Uncomment these when using R2 instead of S3
# Get these from Cloudflare dashboard: https://dash.cloudflare.com/
# R2_BUCKET=urban-legends-submissions
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
# R2_ENDPOINT=  # Auto-generated from account ID if not provided
